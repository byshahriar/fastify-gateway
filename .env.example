# Server
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
# Log channels, comma-separated: console (stdout, default) | file (rotating
# file) | console,file for both at once.
LOG_DESTINATION=console
# File channel options (used when LOG_DESTINATION=file):
LOG_FILE=logs/gateway.log
LOG_ROTATION_FREQUENCY=daily
LOG_ROTATION_MAX_SIZE=10m
LOG_RETENTION_FILES=14
# Buffered async stdout writes: batch log lines until this many bytes
# accumulate (0 = synchronous, default). Higher throughput; a hard crash can
# lose the buffered tail (orderly shutdown flushes it).
LOG_BUFFER_BYTES=0
# Per-request logging: fastify (two built-in lines) | single (one structured
# completion line per request) | off (none; errors still logged).
LOG_REQUEST_STYLE=fastify
# Warn on requests slower than this many milliseconds (0 = off).
SLOW_REQUEST_MS=0
BODY_LIMIT=1048576
# Resolve client IPs from x-forwarded-for. Set to false when clients connect
# directly (no trusted load balancer in front).
TRUST_PROXY=true
KEEP_ALIVE_TIMEOUT_MS=72000
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000

# CORS
# Comma-separated allow-list, or "*" to allow any origin.
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false

# Edge authentication
# Shared secret for services using the "api-key" scheme (x-api-key header).
GATEWAY_API_KEY=change-me
# Comma-separated username:password pairs for the "basic" scheme.
BASIC_AUTH_USERS=admin:change-me
# JWT ("jwt" scheme): a shared HMAC secret or a remote JWKS URI, plus
# optional issuer/audience claims to enforce.
JWT_SECRET=
JWT_JWKS_URI=
JWT_ISSUER=
JWT_AUDIENCE=
# Bearer ("bearer" scheme): validate opaque tokens via your auth service.
BEARER_INTROSPECTION_URL=
BEARER_INTROSPECTION_TOKEN=
# Cache active-token decisions for this many ms (0 disables). A revoked token
# stays accepted until its cached entry expires, so keep it short.
BEARER_CACHE_TTL_MS=0

# IP filtering
# Comma-separated IPs or CIDR ranges, IPv4/IPv6. A non-empty allow list
# blocks every client it does not match; the deny list blocks its matches
# outright and wins. Health probes are never filtered.
IP_ALLOW_LIST=
IP_DENY_LIST=

# Load shedding
# Over these thresholds requests get 503 + Retry-After and /readyz reports
# under-pressure; probes and /metrics stay responsive. 0 disables an
# individual check.
PRESSURE_MAX_EVENT_LOOP_DELAY_MS=1000
PRESSURE_MAX_EVENT_LOOP_UTILIZATION=0.98
PRESSURE_MAX_HEAP_USED_BYTES=0
PRESSURE_MAX_RSS_BYTES=0
PRESSURE_SAMPLE_INTERVAL_MS=1000
PRESSURE_RETRY_AFTER_SECONDS=10

# Response caching
# For services that opt in (requires REDIS_URL). TTL follows the upstream's
# Cache-Control (s-maxage/max-age), capped by CACHE_MAX_TTL_MS.
# CACHE_DEFAULT_TTL_MS=0 caches only what upstreams explicitly allow.
CACHE_ENABLED=false
CACHE_MAX_TTL_MS=60000
CACHE_DEFAULT_TTL_MS=0
CACHE_MAX_BODY_BYTES=1048576

# Rate limiting
# Scoped per client IP.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# Ban a client IP after this many consecutive over-limit responses. 0 = off.
RATE_LIMIT_BAN=0
# Shared rate-limit store across replicas. Empty = in-memory (single instance).
REDIS_URL=

# Observability
# Bearer token required to scrape GET /metrics. Empty leaves it open (protect
# with network policy). Set a token to require Authorization: Bearer <token>.
METRICS_TOKEN=
# Chat alerting: notify one channel on 5xx responses (feature flag).
ALERTS_ENABLED=false
# Active channel: none | slack | discord
ALERT_CHANNEL=none
# Lowest level to alert on: error (5xx) | warn (4xx + 5xx)
ALERT_LEVEL=error
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
ALERT_THROTTLE_MS=60000
# Retries (beyond the first attempt) for webhook delivery, with backoff.
ALERT_RETRIES=2
# OpenTelemetry tracing (feature flag). Uses standard OTEL_* env vars.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=fastify-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=

# Upstream connections
UPSTREAM_TIMEOUT_MS=10000
UPSTREAM_CONNECT_TIMEOUT_MS=2000
UPSTREAM_MAX_CONNECTIONS=128

# Services
USERS_SERVICE_URL=http://localhost:3001
# Optional username:password the gateway presents to the upstream.
USERS_SERVICE_BASIC_AUTH=
ORDERS_SERVICE_URL=http://localhost:3002
ORDERS_SERVICE_BASIC_AUTH=
PUBLIC_SERVICE_URL=http://localhost:3003
